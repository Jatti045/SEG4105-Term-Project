{
  "diagram": "Level-0 Data Flow Diagram",
  "notation": "Gane-Sarson",
  "version": "0.3-draft",
  "parent_diagram": "context-dfd.json",
  "notes": [
    "External entities are inherited from the parent context diagram.",
    "Each external flow names the context flow it comes from in \"parent\". F1a and F1b together are F1, and so on. In \"data\", it lists the parent's data elements that it carries. build_drawio.py checks that every element of every context flow appears exactly once.",
    "Internal flows (I2-I12) run between processes and data stores, so they do not appear on the context diagram.",
    "v0.2 follows ADR-001: the fridge sends raw readings, and the backend runs image recognition. It also follows ADR-002: no offline buffering, so the Device Event Buffer store and flow I1 are removed. Stores are renumbered from D1."
  ],
  "processes": [
    {
      "id": "1.0",
      "name": "Capture and Send Readings",
      "location": "Fridge device",
      "description": "When the door closes, weighs every row, takes a PNG image of each row, and sends the complete snapshot to the backend. No processing on the device (ADR-001) and no local buffering (ADR-002). In this project, a simulator supplies the sensor and camera input, with realistic latency and error rates."
    },
    {
      "id": "2.0",
      "name": "Recognize Items and Update Inventory",
      "location": "Cloud",
      "description": "Runs image recognition on the shelf images and checks the result against the row readings. Matches items to the product catalog, adds and removes stock items, and logs items that were thrown out. Also applies corrections, item details, and waste entries from staff."
    },
    {
      "id": "3.0",
      "name": "Manage Expiry and Stock Alerts",
      "location": "Cloud",
      "description": "Compares stock quantities and expiry dates against configured thresholds. Raises expiry warnings and low-stock notifications, saves them, and delivers them to the configured recipients. Does not raise an alert again while the same one is still active. Clears an alert when the manager clears it."
    },
    {
      "id": "4.0",
      "name": "Answer Inventory Queries",
      "location": "Cloud",
      "description": "Serves the dashboard: current inventory for kitchen staff, and stock levels and usage information for purchasing staff."
    },
    {
      "id": "5.0",
      "name": "Generate Reports",
      "location": "Cloud",
      "description": "Builds inventory and usage reports on request."
    },
    {
      "id": "6.0",
      "name": "Manage Users and Alert Settings",
      "location": "Cloud",
      "description": "Validates and saves user accounts, alert thresholds, and notification preferences, then confirms the change."
    },
    {
      "id": "7.0",
      "name": "Archive Daily Stock",
      "location": "Cloud",
      "description": "Runs at the end of each day. Reads current stock and saves each product's quantity as a daily snapshot. Daily usage is worked out from consecutive snapshots."
    }
  ],
  "data_stores": [
    {
      "id": "D1",
      "name": "Inventory",
      "location": "Cloud",
      "description": "Current stock items: product, row, entry date, expiry date, and status."
    },
    {
      "id": "D2",
      "name": "Product Catalog",
      "location": "Cloud",
      "description": "Known products: name, category, unit, typical shelf life, and recognition label."
    },
    {
      "id": "D3",
      "name": "Alert Settings",
      "location": "Cloud",
      "description": "Low-stock thresholds, expiry warning windows, and notification preferences."
    },
    {
      "id": "D4",
      "name": "Stock History",
      "location": "Cloud",
      "description": "Daily stock snapshots per product, and a record of every item thrown out (waste)."
    },
    {
      "id": "D5",
      "name": "Alerts",
      "location": "Cloud",
      "description": "Every alert raised, with type, product, and status. An alert stays active until the manager clears it."
    },
    {
      "id": "D6",
      "name": "Users",
      "location": "Cloud",
      "description": "Staff who use the dashboard and receive alerts: name, email, role, and whether the account is active."
    }
  ],
